{
  "name": "lmis",
  "version": "1.0.0",
  "description": "Labour Market Intelligence System (LMIS)",
  "private": true,
  "scripts": {
    "dev:api": "npm run dev --prefix apps/api",
    "dev:api:demo": "npm run dev:demo --prefix apps/api",
    "dev:web": "npm run dev --prefix apps/web",
