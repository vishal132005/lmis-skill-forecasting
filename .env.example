# Database
DB_TYPE=sqlite
SQLITE_PATH=./data/lmis.db

# API Server
API_PORT=4000
API_HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# JWT Auth (mock)
JWT_SECRET=lmis-dev-secret-change-in-production
JWT_EXPIRES_IN=24h

# AI Service Config
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT=5000
AI_SERVICE_RETRIES=1
USE_MOCK_MODELS=true

# Python AI Service
AI_PORT=8000
AI_HOST=0.0.0.0

# Frontend
VITE_API_BASE_URL=/api/v1
VITE_APP_TITLE=LMIS - Labour Market Intelligence System
